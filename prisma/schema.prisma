generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// VAI TRÒ HỆ THỐNG (Static RBAC cho SME)
// -----------------------------------------------------------------------------
enum RoleCode {
  ADMIN   // Toàn quyền hệ thống (Ban Giám Đốc, IT Quản trị)
  MANAGER // Quản lý / Trưởng bộ phận (Duyệt dữ liệu, theo dõi phòng ban)
  HR      // Chuyên viên Nhân sự (Quản lý hồ sơ, tài khoản cán bộ nhân viên)
  STAFF   // Nhân viên (Truy cập dữ liệu cá nhân, gửi yêu cầu, nhận việc)
}

// -----------------------------------------------------------------------------
// CORE & TENANT (Công ty thành viên / Chi nhánh trong Tập đoàn)
// -----------------------------------------------------------------------------
model Company {
  id          String       @id @default(uuid())
  name        String       @db.VarChar(255)
  taxCode     String?      @unique @db.VarChar(50)
  address     String?      @db.Text
  isActive    Boolean      @default(true)
  
  users       User[]
  departments Department[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// -----------------------------------------------------------------------------
// ORGANIZATION (Phòng ban / Đơn vị trực thuộc)
// -----------------------------------------------------------------------------
model Department {
  id          String   @id @default(uuid())
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([companyId, code])
}

// -----------------------------------------------------------------------------
// IDENTITY & HR PROFILE (Gộp Tài khoản đăng nhập & Hồ sơ nhân sự)
// -----------------------------------------------------------------------------
model User {
  id           String      @id @default(uuid())
  
  // Thông tin định danh & đăng nhập
  username     String      @unique @db.VarChar(100)
  password     String      @db.VarChar(255) // Hashed password
  
  // Thông tin liên hệ
  email        String?     @unique @db.VarChar(255)
  phone        String?     @unique @db.VarChar(20)
  
  // Thông tin hồ sơ cán bộ nhân viên
  employeeCode String      @unique @db.VarChar(50)
  fullName     String      @db.VarChar(255)
  position     String?     @db.VarChar(100) // Chức vụ (VD: Trưởng phòng Kỹ thuật, Kế toán viên)
  dateOfBirth  DateTime?   @db.Date
  joinDate     DateTime?   @db.Date
  avatarUrl    String?     @db.Text
  address      String?     @db.Text
  
  // Phân quyền & Trạng thái hoạt động
  role         RoleCode    @default(STAFF)
  isActive     Boolean     @default(true)
  
  // Quan hệ Tổ chức
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId, departmentId])
  @@index([role, isActive])
}
