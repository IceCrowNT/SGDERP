generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE & TENANT (Công ty thành viên / Chi nhánh trong Tập đoàn)
// -----------------------------------------------------------------------------
model cong_ty {
  dinh_danh      Int     @id(map: "Company_pkey") @default(autoincrement())
  ten_cong_ty    String  @db.VarChar(255)
  ma_so_thue     String? @unique(map: "Company_taxCode_key") @db.VarChar(50)
  dia_chi        String? @db.Text
  dang_hoat_dong Boolean @default(true)

  danh_sach_tai_khoan tai_khoan[]
  danh_sach_nhan_su   nhan_su[]
  danh_sach_phong_ban phong_ban[]
  danh_sach_vai_tro   vai_tro[]
  danh_sach_nhat_ky   nhat_ky_hoat_dong[]

  thoi_diem_tao      DateTime @default(now())
  thoi_diem_cap_nhat DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ORGANIZATION (Phòng ban / Ban QLDA / Bộ phận trực thuộc)
// -----------------------------------------------------------------------------
model phong_ban {
  dinh_danh     Int     @id(map: "Department_pkey") @default(autoincrement())
  ma_phong_ban  String  @db.VarChar(50)
  ten_phong_ban String  @db.VarChar(255)
  mo_ta         String? @db.Text

  // Lịch sử nhập cơ cấu ban đầu; từ 03/11/2026 ERP quản lý độc lập, không khóa/đối soát nguồn.
  he_thong_nguon               String?   @db.VarChar(50)
  dinh_danh_nguon              String?   @db.VarChar(100)
  dinh_danh_cap_tren_nguon     String?   @db.VarChar(100)
  ten_nguon                    String?   @db.VarChar(255)
  duong_dan_nguon              String?   @db.Text
  cap_nguon                    Int?
  ten_nguoi_giam_sat_nguon     String?   @db.VarChar(255)
  thoi_diem_chup_du_lieu_nguon DateTime?

  // Cấu trúc phân cấp Cây Phòng Ban (Cha - Con)
  dinh_danh_phong_ban_cha Int?
  phong_ban_cha           phong_ban?  @relation(map: "Department_parentId_fkey", "DepartmentHierarchy", fields: [dinh_danh_phong_ban_cha], references: [dinh_danh], onDelete: SetNull)
  phong_ban_con           phong_ban[] @relation("DepartmentHierarchy")

  dinh_danh_cong_ty Int
  cong_ty           cong_ty @relation(map: "Department_companyId_fkey", fields: [dinh_danh_cong_ty], references: [dinh_danh], onDelete: Restrict)

  danh_sach_nhan_su nhan_su[]

  thoi_diem_tao      DateTime @default(now())
  thoi_diem_cap_nhat DateTime @updatedAt

  @@unique([dinh_danh, dinh_danh_cong_ty])
  @@unique([dinh_danh_cong_ty, ma_phong_ban], map: "Department_companyId_code_key")
  @@unique([dinh_danh_cong_ty, he_thong_nguon, dinh_danh_nguon], map: "Department_companyId_externalSystem_externalId_key")
  @@index([dinh_danh_cong_ty, he_thong_nguon], map: "Department_companyId_externalSystem_idx")
  @@index([dinh_danh_cap_tren_nguon], map: "Department_externalParentId_idx")
}

// -----------------------------------------------------------------------------
// IDENTITY & HR PROFILE (Định danh tài khoản & Hồ sơ nhân sự)
// -----------------------------------------------------------------------------
model nhan_su {
  dinh_danh                    Int              @id @default(autoincrement())
  ma_nhan_su                   String           @default(dbgenerated("tao_ma_nhan_su()")) @db.VarChar(50)
  ho_ten                       String           @db.VarChar(255)
  chuc_vu                      String?          @db.VarChar(100)
  thu_dien_tu                  String?          @db.VarChar(255)
  so_dien_thoai                String?          @db.VarChar(20)
  ngay_sinh                    DateTime?        @db.Date
  ngay_vao_lam                 DateTime?        @db.Date
  duong_dan_anh_dai_dien       String?          @db.Text
  dia_chi                      String?          @db.Text
  tinh_trang_lam_viec          EmploymentStatus @default(UNKNOWN)
  he_thong_nguon               String?          @db.VarChar(50)
  dinh_danh_nguon              String?          @db.VarChar(100)
  thoi_diem_chup_du_lieu_nguon DateTime?
  tep_nguon_nhan_su_hr         String?          @db.VarChar(255)
  ngay_chot_nhan_su_hr         DateTime?        @db.Date
  ghi_chu                      String?          @db.Text
  ghi_chu_nhan_su_hr           String?          @db.Text
  dinh_danh_cong_ty            Int
  cong_ty                      cong_ty          @relation(fields: [dinh_danh_cong_ty], references: [dinh_danh], onDelete: Restrict)
  dinh_danh_phong_ban          Int?
  phong_ban                    phong_ban?       @relation(fields: [dinh_danh_phong_ban, dinh_danh_cong_ty], references: [dinh_danh, dinh_danh_cong_ty], onDelete: Restrict)
  danh_sach_tai_khoan          tai_khoan[]
  thoi_diem_tao                DateTime         @default(now())
  thoi_diem_cap_nhat           DateTime         @updatedAt

  @@unique([dinh_danh, dinh_danh_cong_ty])
  @@unique([dinh_danh_cong_ty, ma_nhan_su], map: "nhan_su_dinh_danh_cong_ty_ma_nhan_vien_key")
  @@unique([dinh_danh_cong_ty, he_thong_nguon, dinh_danh_nguon])
  @@index([dinh_danh_cong_ty, dinh_danh_phong_ban])
  @@index([dinh_danh_cong_ty, tinh_trang_lam_viec])
}

enum EmploymentStatus {
  ACTIVE
  LEFT
  UNKNOWN
}

model tai_khoan {
  dinh_danh           Int                 @id(map: "User_pkey") @default(autoincrement())
  ten_dang_nhap       String              @unique(map: "User_username_key") @db.VarChar(100)
  mat_khau_bam        String              @db.VarChar(255)
  ten_hien_thi        String              @db.VarChar(255)
  cho_phep_dang_nhap  Boolean             @default(true)
  phien_ban_dang_nhap Int                 @default(0)
  dinh_danh_cong_ty   Int
  cong_ty             cong_ty             @relation(map: "User_companyId_fkey", fields: [dinh_danh_cong_ty], references: [dinh_danh], onDelete: Restrict)
  dinh_danh_nhan_su   Int?
  nhan_su             nhan_su?            @relation(map: "nguoi_dung_dinh_danh_nhan_su_dinh_danh_cong_ty_fkey", fields: [dinh_danh_nhan_su, dinh_danh_cong_ty], references: [dinh_danh, dinh_danh_cong_ty], onDelete: Restrict)
  danh_sach_vai_tro   tai_khoan_vai_tro[]
  danh_sach_nhat_ky   nhat_ky_hoat_dong[]
  thoi_diem_tao       DateTime            @default(now())
  thoi_diem_cap_nhat  DateTime            @updatedAt

  @@index([cho_phep_dang_nhap], map: "User_isActive_idx")
  @@index([dinh_danh_nhan_su, dinh_danh_cong_ty], map: "nguoi_dung_dinh_danh_nhan_su_dinh_danh_cong_ty_idx")
}

// -----------------------------------------------------------------------------
// RBAC - NHÓM VAI TRÒ (Roles)
// -----------------------------------------------------------------------------
model vai_tro {
  dinh_danh           Int     @id(map: "Role_pkey") @default(autoincrement())
  ma_vai_tro          String  @db.VarChar(50) // VD: "ADMIN", "DIRECTOR", "DEPT_HEAD", "HR", "ACCOUNTANT", "STAFF"
  ten_vai_tro         String  @db.VarChar(255) // VD: "Ban Giám Đốc", "Trưởng Phòng / Bộ Phận", "Nhân Sự", "Nhân Viên"
  mo_ta               String? @db.Text
  la_vai_tro_he_thong Boolean @default(false) // Vai trò mặc định hệ thống không thể xóa

  dinh_danh_cong_ty Int
  cong_ty           cong_ty @relation(map: "Role_companyId_fkey", fields: [dinh_danh_cong_ty], references: [dinh_danh], onDelete: Restrict)

  danh_sach_quyen     vai_tro_quyen[]
  danh_sach_tai_khoan tai_khoan_vai_tro[]

  thoi_diem_tao      DateTime @default(now())
  thoi_diem_cap_nhat DateTime @updatedAt

  @@unique([dinh_danh_cong_ty, ma_vai_tro], map: "Role_companyId_code_key")
}

// -----------------------------------------------------------------------------
// RBAC - DANH MỤC QUYỀN THEO PHÂN HỆ (Module Permissions)
// -----------------------------------------------------------------------------
model quyen {
  dinh_danh Int     @id(map: "Permission_pkey") @default(autoincrement())
  phan_he   String  @db.VarChar(50) // VD: "HR", "TASK", "SYSTEM", "REPORT"
  hanh_dong String  @db.VarChar(50) // VD: "VIEW", "CREATE", "UPDATE", "DELETE", "APPROVE", "ASSIGN", "MANAGE"
  ten_quyen String  @db.VarChar(255) // Tên hiển thị (VD: "Xem danh bạ nhân sự", "Giao việc phòng ban")
  mo_ta     String? @db.Text
  pham_vi   String  @default("ALL") @db.VarChar(20) // "ALL" (Toàn công ty), "DEPARTMENT" (Nội bộ phòng), "PERSONAL" (Cá nhân)

  danh_sach_vai_tro vai_tro_quyen[]

  thoi_diem_tao      DateTime @default(now())
  thoi_diem_cap_nhat DateTime @updatedAt

  @@unique([phan_he, hanh_dong], map: "Permission_module_action_key")
  @@index([phan_he], map: "Permission_module_idx")
}

// -----------------------------------------------------------------------------
// RBAC - LIÊN KẾT VAI TRÒ & QUYỀN HẠN (Role - Permission Matrix)
// -----------------------------------------------------------------------------
model vai_tro_quyen {
  dinh_danh_vai_tro Int
  vai_tro           vai_tro @relation(map: "RolePermission_roleId_fkey", fields: [dinh_danh_vai_tro], references: [dinh_danh], onDelete: Cascade)

  dinh_danh_quyen Int
  quyen           quyen @relation(map: "RolePermission_permissionId_fkey", fields: [dinh_danh_quyen], references: [dinh_danh], onDelete: Cascade)

  thoi_diem_gan DateTime @default(now())

  @@id([dinh_danh_vai_tro, dinh_danh_quyen], map: "RolePermission_pkey")
}

// -----------------------------------------------------------------------------
// RBAC - LIÊN KẾT NGƯỜI DÙNG & VAI TRÒ (User - Role & Kiêm nhiệm)
// -----------------------------------------------------------------------------
model tai_khoan_vai_tro {
  dinh_danh_tai_khoan Int
  tai_khoan           tai_khoan @relation(map: "UserRole_userId_fkey", fields: [dinh_danh_tai_khoan], references: [dinh_danh], onDelete: Cascade)

  dinh_danh_vai_tro Int
  vai_tro           vai_tro @relation(map: "UserRole_roleId_fkey", fields: [dinh_danh_vai_tro], references: [dinh_danh], onDelete: Cascade)

  la_vai_tro_chinh Boolean  @default(false) // Vai trò chính hoặc vai trò kiêm nhiệm
  thoi_diem_gan    DateTime @default(now())

  @@id([dinh_danh_tai_khoan, dinh_danh_vai_tro], map: "UserRole_pkey")
}

// -----------------------------------------------------------------------------
// AUDIT LOG - NHẬT KÝ KIỂM TOÁN VÀ LỊCH SỬ HOẠT ĐỘNG TOÀN HỆ THỐNG
// -----------------------------------------------------------------------------
model nhat_ky_hoat_dong {
  dinh_danh Int @id(map: "AuditLog_pkey") @default(autoincrement())

  // Định danh người thực hiện
  dinh_danh_tai_khoan Int?
  tai_khoan           tai_khoan? @relation(map: "AuditLog_userId_fkey", fields: [dinh_danh_tai_khoan], references: [dinh_danh], onDelete: SetNull)
  ten_dang_nhap       String     @db.VarChar(100)
  ho_ten              String     @db.VarChar(255)

  // Chi tiết thao tác & Phân hệ
  hanh_dong           String  @db.VarChar(50) // LOGIN, LOGOUT, LOGIN_FAILED, CREATE, UPDATE, DELETE, STATUS_CHANGE
  phan_he             String  @db.VarChar(50) // AUTH, HR, DEPARTMENT, ROLE, TASK, SYSTEM
  dinh_danh_doi_tuong String? @db.VarChar(100) // ID đối tượng bị tác động
  ten_doi_tuong       String? @db.VarChar(255) // Tên đối tượng (VD: "Nguyễn Văn A", "Phòng Kế toán")

  // Diễn giải và snapshot dữ liệu
  mo_ta       String @db.Text
  du_lieu_cu  Json?
  du_lieu_moi Json?

  // Thông tin mạng
  dia_chi_ip            String? @db.VarChar(50)
  thong_tin_trinh_duyet String? @db.Text

  // Multi-tenancy
  dinh_danh_cong_ty Int
  cong_ty           cong_ty @relation(map: "AuditLog_companyId_fkey", fields: [dinh_danh_cong_ty], references: [dinh_danh], onDelete: Cascade)

  thoi_diem_tao DateTime @default(now())

  @@index([dinh_danh_cong_ty, phan_he, thoi_diem_tao], map: "AuditLog_companyId_module_createdAt_idx")
  @@index([dinh_danh_tai_khoan], map: "AuditLog_userId_idx")
}
