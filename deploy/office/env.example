# Copy values to ERP environment; never commit the real secret.
OFFICE_PUBLIC_URL=http://localhost:8088
OFFICE_INTERNAL_URL=http://localhost:8088
# URL reachable FROM the document-server container:
OFFICE_APP_URL=http://host.docker.internal:4000
# Generate 32+ random bytes, use the SAME value in ERP and .env.office for Compose.
OFFICE_JWT_SECRET=

# Enable only with an edition supporting mobile web editing.
OFFICE_MOBILE_EDIT_ENABLED=false
