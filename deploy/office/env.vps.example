# VPS Linux: replace domains and secret before use. Never commit real credentials.
OFFICE_PUBLIC_URL=https://office.example.vn
# When ERP runs directly on the same VPS host:
OFFICE_INTERNAL_URL=http://127.0.0.1:8088
# Must resolve and be reachable FROM the Office container:
OFFICE_APP_URL=https://erp.example.vn
OFFICE_JWT_SECRET=
OFFICE_MOBILE_EDIT_ENABLED=false
OFFICE_IMAGE=onlyoffice/documentserver:10.0.0.1
